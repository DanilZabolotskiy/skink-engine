{
 "_doc": "Action library of the staging layer (docs/STAGING.md). An action: prop / to — which prop state it changes and to what; from — the start value if the state is not set yet; dur — default length, s; sfx — sounds [id, fraction of the event PROGRESS 0–1 or 'end' / 'start', offset s] (the progress is smooth; 'end' — the state within 0.5 % of the range from its final value: the leaf visibly stopped; 'start' — visibly started; the same for any event length, tools/pipeline/staging.py SEEN; 0.1 for paper — the sheet visibly starts moving); offscreen — sounds whose source is not visible in the frame (a motor, a bell); hand — a hand moves the prop: the event needs who with a gesture at the start of the motion, or \"hand\": \"<why the hand is not visible>\", or \"by\": \"<what moves it>\"; need — required event fields. A channel adds and replaces entries in pipeline/channel.json → actions, poses. verbs — 'shot line → event': a verb of ON SCREEN / camera (re, lower case) and the events that perform it (need — variants; a variant is requirements joined by '+': <do>[:<pose|to|obj|pace>|…][!<field>][@], @ — an event of the one who acts; sfx:<id> — a sound of the shot; line@ / line:any / line:who — a line in the shot). A matched piece of the line is closed for the next entries, so specific entries go before general ones; a channel adds channel.json → action_verbs, which go first. vo_verbs — past tense in the VO of an English script: a list for the eye. prop.fall / prop.roll / prop.stop / prop.spin — the prop (obj) falls, rolls, stops, spins: state down / roll / spin. poses — gesture poses (gesture → pose), solved by lib/character/body.ts and drawn by the drawing style.",
 "actions": {
  "set": {},
  "cue": {"dur": 0},
  "cut": {"dur": 0},
  "walk": {},
  "gesture": {"dur": 1.0},
  "look": {"dur": 1.0},
  "door.open": {"prop": "open", "to": 0.6, "from": 0, "dur": 0.9, "sfx": [["door", "start", 0]], "hand": true},
  "door.close": {"prop": "open", "to": 0, "from": 0.6, "dur": 0.9, "sfx": [["door", "end", 0]], "hand": true},
  "window.close": {"prop": "open", "to": 0, "from": 1, "dur": 1.0, "sfx": [], "hand": true},
  "lamp.flicker": {"dur": 1.0, "sfx": [["lamp_flicker", 0, 0]]},
  "lamp.off": {"prop": "on", "to": 0, "from": 1, "dur": 0.25, "sfx": [["lamp_click", 0, 0]]},
  "lamp.on": {"prop": "on", "to": 1, "from": 0, "dur": 0.1, "sfx": [["lamp_click", 0, 0]]},
  "lamp.burst": {"prop": "on", "to": 0, "from": 1, "dur": 0.1, "sfx": [["impact", 0, 0]]},
  "paper.slide": {"dur": 1.2, "sfx": [["paper", 0.1, 0]]},
  "paper.open": {"dur": 1.0, "sfx": [["paper", 0.1, 0]]},
  "paper.unfold": {"dur": 2.5, "sfx": [["paper", 0.1, 0]]},
  "pen.mark": {"dur": 1.0, "sfx": []},
  "stamp.press": {"dur": 1.0, "sfx": [["stamp", 1, 0]]},
  "box.set": {"dur": 1.3, "sfx": [["box_thud", 1, 0]]},
  "hand.grab": {"dur": 0.7, "sfx": []},
  "hand.out": {"dur": 1.0, "sfx": []},
  "beam.sweep": {"dur": 1.2, "sfx": []},
  "keypad.light": {"dur": 0.6, "sfx": []},
  "drop.run": {"dur": 2.0, "sfx": []},
  "prop.fall": {"prop": "down", "to": 1, "from": 0, "dur": 0.6, "sfx": []},
  "prop.roll": {"prop": "roll", "to": 1, "from": 0, "dur": 1.2, "sfx": []},
  "prop.stop": {"dur": 0.5, "sfx": []},
  "prop.spin": {"prop": "spin", "to": 1, "from": 0, "dur": 3.0, "sfx": []}
 },
 "poses": {
  "push": "pushes a door away: the palm on the leaf (grip: fist — a fist on the handle) at the kit's reach point; facing — from the doorway, from behind — the hand beyond the elbow; without reach from behind — at the waist",
  "pull": "pulls a door: a fist on the handle at the kit's reach point, the elbow down and back",
  "press": "presses a sheet to the wall with the palm and smooths it down",
  "write": "writes a line with a pen in the folder held by the other hand",
  "dial": "dials (like tap) and lifts the phone to the ear; use with stay",
  "tap": "the phone on the palm screen up, the thumb taps the screen",
  "hangup": "lowers the phone from the ear in front and holds it",
  "rail": "the hand on a rail at the kit's reach point, the fingers tap",
  "count": "counts on the fingers of the free hand at the chest, palm towards the viewer: the fingers unfold one by one (n — how many, 1–4); facing only",
  "straighten": "straightens up: slightly stooped at the start of the event, straight by the end (stay — stays)",
  "point": "runs a fingertip along a line of a sheet (the kit draws the hand)"
 },
 "verbs": [
  {"re": "\\bpulls?\\b[^;,]*\\bdoor\\b[^;,]*\\b(shut|closed|to)\\b|\\bpulls the door\\b|\\bpulls it (shut|closed|to)\\b", "need": ["door.close+gesture:pull@"], "what": "pulls a door"},
  {"re": "\\bpush(es)?\\b[^;,]*\\bdoor\\b|\\bpushes (it|the door) open\\b", "need": ["door.open+gesture:push@"], "what": "pushes a door"},
  {"re": "\\bopens (the|his|her|a) (\\w+ )?door\\b|\\bopens it\\b", "need": ["door.open+gesture:push|pull@"], "what": "opens a door by hand"},
  {"re": "\\bslides? it (shut|closed|open)\\b|\\bwindow\\b[^;,]*\\b(closes|shuts|opens|slides (shut|open))\\b|\\b(shuts|closes|opens) the window\\b", "need": ["window."], "what": "window"},
  {"re": "\\bdoors (open|close|slide|part)\\b|\\bopening doors\\b|\\bdoors (opening|closing)\\b", "need": ["door."], "what": "doors"},
  {"re": "\\bdoor\\b[^;,]*?\\b(opens|closes|shuts|swings (open|shut|closed)|slams( shut)?|clicks shut|creaks open)\\b|\\bswings (open|shut)\\b|\\bslams\\b", "need": ["door."], "what": "door"},
  {"re": "\\b(lamp|bulb|light|tube)s?\\b[^;,]*\\b(bursts?|pops?|shatters?|explodes?)\\b", "need": ["lamp.burst"], "what": "a lamp bursts"},
  {"re": "\\b(lamp|bulb|light|tube)s?\\b[^;,]*\\b(goes out|go out|goes off|go off|dies|die|cuts out|switch(es)? off|turns? off|goes dark|go dark)\\b|\\bdie one by one\\b", "need": ["lamp.off", "lamp.burst"], "what": "a lamp goes out"},
  {"re": "\\b(lamp|bulb|light|tube)s?\\b[^;,]*\\b(clicks on|comes on|come on|switch(es)? on|turns? on|lights up|flicks on)\\b", "need": ["lamp.on"], "what": "a lamp comes on"},
  {"re": "\\bflicker(s|ing)?\\b|\\bstrobes?\\b", "need": ["lamp.flicker"], "what": "a lamp flickers"},
  {"re": "\\b(keypad|lock|panel)\\b[^;,]*\\b(lights up|glows|blinks|beeps|flashes)\\b|\\blights up from inside\\b", "need": ["keypad."], "what": "door lock"},
  {"re": "\\bbeam\\b[^;,]*\\b(sweep(s|ing)?|bob(s|bing)?|slash(es|ing)?|swing(s|ing)?|mov(es|ing)|reach(es|ing)|track(s|ing)?|cross(es|ing)?|slid(es|ing)|play(s|ing)|flick(s|ing)?|jerk(s|ing)?)\\b", "need": ["beam."], "what": "torch beam"},
  {"re": "\\bdrops? (runs?|rolls?|slides?|trickles?|crawls?)\\b|\\bdrips?\\b|\\btrickles?\\b", "need": ["drop."], "what": "a drop"},
  {"re": "\\bhand\\b[^;,]*\\b(grabs|grips|seizes|takes|reaches|enters|pulls|appears|withdraws|comes)\\b|\\bgrabs\\b|\\bseizes\\b", "need": ["hand.", "pen.", "stamp.", "paper.", "window."], "what": "a hand (hand event: hand.*, pen, stamp, paper, window)"},
  {"re": "\\bstamps\\b|\\bstamp (comes down|lands|hits|presses)\\b", "need": ["stamp."], "what": "stamp"},
  {"re": "\\b(underlines|circles|crosses out|ticks off|strikes out|draws)\\b", "need": ["pen.", "gesture:write@"], "what": "pen"},
  {"re": "\\bunfolds?\\b|\\bunfolding\\b", "need": ["paper.unfold"], "what": "a sheet unfolds"},
  {"re": "\\bslides? (into|onto|in|across|out of|over) (frame|the frame|view|the desk|\\w+'s desk)\\b|\\bslides\\b[^;,]*\\b(onto|across)\\b", "need": ["paper.slide", "box.", "prop."], "what": "a prop slides in"},
  {"re": "\\b(folder|file|book|notebook|envelope|letter|binder|lid|cover)\\b[^;,]*\\bopens\\b|\\bflips (open|the page|through)\\b|\\bturn(s|ing) the page\\b", "need": ["paper.open", "paper.unfold"], "what": "folder, page"},
  {"re": "\\blands\\b|\\bsets\\b[^;,]*\\bdown\\b|\\bputs\\b[^;,]*\\bdown\\b|\\bplaces\\b", "need": ["box.", "paper.", "prop."], "what": "puts down, places"},
  {"re": "\\brolls the (cart|trolley|stroller|suitcase)\\b|\\bpushes the (cart|trolley|stroller|pram|wheelchair)\\b", "need": ["walk@"], "what": "rolls a trolley"},
  {"re": "\\b(cart|trolley|stroller|pram|wheelchair|suitcase)\\b[^;,]*\\b(stops|halts|rolls|tips|topples|falls|jolts)\\b", "need": ["prop.", "walk"], "what": "trolley"},
  {"re": "\\b(chair|stool|wheel|fan|sign)\\b[^;]*\\b(turning|spinning|rotating|swivell?ing|spins|swivels|rotates|turns)\\b", "need": ["prop.spin"], "what": "a prop spins"},
  {"re": "\\b(falls|topples|tips over|tumbles|spills|rolls away|rolls off|rolls)\\b", "need": ["prop.fall", "prop.roll"], "what": "a prop falls, rolls"},
  {"re": "\\bfingers?\\b[^;,]*\\b(tick|tap|drum)\\w*\\b|\\b(tick|tap|drum)\\w* (on|against|along) the (rail|railing|banister|handrail)\\b", "need": ["gesture:rail@"], "what": "fingers tap on a rail"},
  {"re": "\\bfinger(tip)?s?\\b[^;,]*\\b(stops|runs|moves|traces|slides|rests|follows)\\b|\\bpoints\\b|\\bpointing\\b|\\btraces\\b", "need": ["gesture:point@", "hand."], "what": "a finger along a line, points"},
  {"re": "\\bcount(s|ing)? on (his|her|their|the) fingers\\b|\\bcounting on fingers\\b|\\bcounts (the )?steps\\b", "need": ["gesture:count@"], "what": "counts on fingers"},
  {"re": "\\bhangs up\\b|\\blowers (the|his|her) phone\\b|\\bputs (the|his|her) phone down\\b", "need": ["gesture:hangup@"], "what": "lowers the phone"},
  {"re": "\\bpresses\\b|\\bpressing\\b|\\bpushes (the )?(button|bell|call button)\\b|\\brings the (door)?bell\\b", "need": ["gesture:press|push|point@"], "what": "presses"},
  {"re": "\\bwrites\\b|\\bwriting\\b|\\bjots\\b|\\bscribbles\\b|\\bsigns (the|a|his|her)\\b|\\bnotes down\\b|\\bfills (in|out) the\\b", "need": ["gesture:write@", "pen."], "what": "writes"},
  {"re": "\\bstraightens( up)?\\b", "need": ["gesture:straighten@"], "what": "straightens up"},
  {"re": "\\b(stands up|gets up|rises to (his|her) feet|sits down|sits up|lies down)\\b", "need": ["gesture:stand|sit@", "walk@"], "what": "stands up, sits down"},
  {"re": "\\b(bends|crouches|kneels|squats|stoops|leans (in|over|forward|back|down|closer))\\b", "need": ["gesture:bend|crouch|kneel|lean@"], "what": "bends"},
  {"re": "\\b(waves|nods|shrugs|beckons|gestures)\\b|\\braises (his|her) (hand|arm)\\b|\\blifts (his|her|the)\\b|\\bholds (it|the \\w+|his \\w+|her \\w+) (up|out)\\b|\\breaches (for|out|into|toward)\\b", "need": ["gesture@"], "what": "gesture"},
  {"re": "\\bin time with (the |a |her |his )?(?P<who>[a-z]+)(?:'s)? voice\\b", "need": ["line:who"], "what": "in time with a voice"},
  {"re": "\\bvoice\\b[^;,]*\\b(keeps going|continues|goes on|calls|answers|says|speaks)\\b", "need": ["line:any"], "what": "a voice sounds in the shot"},
  {"re": "\\blips moving\\b|\\b(repeats|repeating|says|saying|mutters|muttering|murmurs|answers|replies|speaks|speaking|talks|talking|shouts|shouting|calls out|whispers|whispering)\\b", "need": ["line@"], "what": "speaks"},
  {"re": "\\bdials\\b|\\bdialing\\b|\\bcalls\\b|\\btaps (the|his|her) (screen|phone|number)\\b", "need": ["gesture:dial|tap@"], "what": "dials a number"},
  {"re": "\\bwhine(s|d)?\\b|\\bwhimper(s|ing)?\\b|\\bwhining\\b", "need": ["sfx:whine"], "what": "whine (sound)"},
  {"re": "\\bthump(s|ing)?\\b|\\bknock(s|ing)?\\b|\\bbang(s|ing)?\\b|\\braps\\b|\\brapping\\b", "need": ["sfx:knock"], "what": "knock (sound)"},
  {"re": "\\b(rings|ringing|buzz(es|ing)|vibrat(es|ing))\\b", "need": ["sfx:phone|doorbell|lamp_flicker"], "what": "ring, vibration (sound)"},
  {"re": "\\b(beeps?|chimes?|dings?)\\b", "need": ["sfx:beep|chime"], "what": "beep (sound)"},
  {"re": "\\b(exhales?|sighs?)\\b|\\bbreathes? out\\b", "need": ["sfx:exhale"], "what": "exhale (sound)"},
  {"re": "\\blooks\\b(?! like)|\\blook (up|down|at|back|around|over|away)\\b|\\bglances?\\b|\\bglancing\\b|\\bturns? (her |his |their )?head\\b|\\bturns (to|toward|towards|around|back|away)\\b|\\beyes slid(e|es|ing)\\b|\\bpeers\\b|\\bpeeks?\\b", "need": ["look@"], "what": "look, head turn"},
  {"re": "\\bstops? (beside|by|next to|in front of|before|at|outside|near) (?!the sound|a sound|the noise|the voice)|\\b(goes|walks|slips|disappears) (in|into|inside|through)\\b|\\b(up|over) to (door|the door|the \\w+ door|\\d{4})\\b", "need": ["walk!at@"], "what": "stops at a prop, goes in"},
  {"re": "\\b(runs|running|rushes|rushing|dashes|dashing|sprints|sprinting|flees|fleeing|races|racing)\\b|\\b(going|goes|descending|descends|climbing|climbs|walking|walks|coming|comes)\\b[^;,]*\\bfast\\b", "need": ["walk:run@"], "what": "runs"},
  {"re": "\\b(walk(s|ing)?|climb(s|ing)?|descend(s|ing)?|approach(es|ing)|hurr(ies|ying)|tiptoe(s|ing)?|wander(s|ing)?|strides?|striding|limp(s|ing)?|paces|pacing|slows|stops|halts|retreats|backs away)\\b|\\bgo(es|ing)? (back )?(down|up|in|into|out|inside|toward|towards|away|on|back|over)\\b|\\bstep(s|ping)? (in|out|inside|into|forward|back|off|up|down|aside|away)\\b|\\bgets? (in|out|off|on)\\b|\\bmov(es|ing) (on|in|away|off|toward|towards|closer|forward)\\b|\\brolls the cart\\b|\\bpass(es|ing) (door|the door|by|\\d{4}|the \\w+ door)\\b|\\bcomes? (in|out|toward|towards|closer|up|down|back|over)\\b|\\bleaves\\b", "need": ["walk@"], "what": "walks"},
  {"re": "\\bnumbers?\\b[^;]*\\bpass\\b|\\bflight after flight\\b|\\bfloor after floor\\b", "need": ["cut", "walk"], "what": "floors go by"}
 ],
 "vo_verbs": [
  {"re": "\\b(went|walked|ran|climbed|came|stepped|left|entered|stopped)\\b", "need": ["walk@"], "what": "walked (narration)"},
  {"re": "\\b(looked|glanced|turned)\\b", "need": ["look@"], "what": "looked (narration)"},
  {"re": "\\b(called|dialed|dialled|counted|knocked|pressed|wrote|opened|closed|shut|grabbed|picked up|hung up|pointed|waved)\\b", "need": ["gesture@", "door.", "pen.", "hand."], "what": "did by hand (narration)"}
 ]
}
