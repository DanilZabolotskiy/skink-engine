# The repository holds code, configs and docs. Work folders, renders and media stay on each machine.

# Secrets
.env
*.env
!.env.example
._*
.DS_Store
Thumbs.db

# Node (in an episode worktree node_modules is a link to the main checkout, docs/PARALLEL.md)
node_modules
out/
.remotion/
.bundle-*/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors and agent tooling (the shared Claude Code skills and agents of the chapter flow are in git, local settings are not)
.vscode/
.idea/
.claude/*
!.claude/skills/
!.claude/agents/

# Chapter work folders (renders, voice, checks) and media libraries; in an episode worktree they are links to the main checkout
channels/*/episodes
channels/*/assets/sound
channels/*/assets/music

# The API reference — every checkout writes its own (tools/api_ref.py, docs/PARALLEL.md)
docs/API.md

# Images, sound, video
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp3
*.wav
*.ogg
*.m4a
*.mp4
*.mov
*.mkv
*.webm
# docs images (the README screenshot)
!docs/*.png
!docs/*.jpg

# Logs, archives
*.log
*.zip
*.7z
